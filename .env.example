# Database (Supabase). Copy both from Supabase dashboard -> Connect -> ORMs -> Prisma.
# Locally you can also point both at a local Postgres, as below.
# DATABASE_URL: transaction pooler, port 6543, ending in ?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emp"
# DIRECT_URL: session pooler or direct connection, port 5432 (used for migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/emp"
# Public URL of the app, used in emails and calendar files
APP_URL="http://localhost:3000"
# First super admin. On an empty database this email can sign in and becomes super admin.
ADMIN_EMAIL="admin@emp.local"
# Shows one-time codes on the sign-in screen. NEVER enable in production.
SHOW_DEV_CODES="true"
# Secret for /api/cron/tick (send as ?key= or Authorization: Bearer)
CRON_SECRET="change-me"
# --- Email (leave blank to log emails to the in-app outbox only) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="EMP <no-reply@emp.local>"
# --- Google Meet (leave blank to use manual meeting links) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
